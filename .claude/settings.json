{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Projects/template/apps/.claude/hooks/graphify_guard.py pre",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Projects/template/apps/.claude/hooks/graphify_guard.py post",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
