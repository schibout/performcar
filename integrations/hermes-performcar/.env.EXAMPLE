# Copiez ce fichier en .env dans le dossier du profil, puis renseignez les valeurs.

# Modèle : voir model dans config.yaml (abonnement openai-codex du serveur Hermes).

# API Hermes (OpenAI-compatible) utilisée par EasyDevis : même valeur que
# HERMES_API_KEY dans backend/.env.
API_SERVER_KEY=

# API PerformCar EasyDevis (préfixe /api/v1 inclus)
EASYDEVIS_API_URL=http://127.0.0.1:8000/api/v1
# Clé de service partagée avec EasyDevis (ASSISTANT_SERVICE_KEY de backend/.env).
# Les outils agissent au nom de l'utilisateur connecté grâce au ticket de conversation.
EASYDEVIS_SERVICE_KEY=

# Chemin absolu du serveur MCP du profil, par exemple :
# C:\Users\<vous>\AppData\Local\hermes\profiles\performcar\mcp\easydevis
# EASYDEVIS_MCP_DIR plus utilise (chemin fixe dans config.yaml)

# Passerelle de messagerie (facultatif) — voir README.md
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=
# WHATSAPP_ENABLED=false
# WHATSAPP_MODE=bot
# WHATSAPP_ALLOWED_USERS=
